# ==============================================================================
# SJF Catalog — Environment Template  (Zero-Trust)
# ------------------------------------------------------------------------------
# Copy to `.env.local` (git-ignored) and fill REAL values there — OR set them in
# the Conda env: `conda env config vars set -n sjfu-catalog KEY="value"`.
# NEVER put real secrets in this file or commit them. This template is the
# hand-off contract: it lists every variable the app needs, with no values.
#
# Legend:  [public] safe to expose to the browser   [secret] server-only
# ==============================================================================

# ── Supabase: spoke project `zkoimkcctqigisfeqlpv` ("SJF-Catalog-Project", us-east-2)
NEXT_PUBLIC_SUPABASE_URL=https://zkoimkcctqigisfeqlpv.supabase.co   # [public]
NEXT_PUBLIC_SUPABASE_ANON_KEY=                                      # [public] publishable anon key
SUPABASE_SERVICE_ROLE_KEY=                                          # [secret] admin / migrations only
DATABASE_URL=                                                      # [secret] pooled Postgres connection string

# ── Embeddings: gemini-embedding-001 @ 1536 (query + stored share one space)
#    TWO interchangeable auth paths — same model, same dimension:
#    (A) Vertex AI, KEYLESS — Adam's business account (API keys disallowed by org policy).
#        Set GCP_PROJECT_ID + ADC/SA below; leave GEMINI_API_KEY blank. This is the default.
#    (B) Google AI Studio API key — for CLIENT HANDOFF. Set GEMINI_API_KEY and the app +
#        `npm run reembed` use the key path instead. Pick with `reembed --provider vertex|gemini`.
GEMINI_API_KEY=                                                    # [secret] path (B) only — leave blank when using Vertex

# ── FastAPI swarm / catalog-production agent
NEXT_PUBLIC_SWARM_API_URL=                                         # [public] base URL of the swarm API
SWARM_API_TOKEN=                                                   # [secret] auth for server→swarm calls

# ── Generation LLM (GCP-hosted: Vertex Gemini or self-hosted Cloud Run GPU)
GCP_PROJECT_ID=                                                    # [secret]
GOOGLE_APPLICATION_CREDENTIALS=                                    # [secret] path to service-account json (never commit the json)
GCP_LOCATION=us-central1                                           # [config] Vertex region for the Next.js app. Serves gemini-embedding-001,
                                                                   #   which produces query vectors — must match scripts/reembed.mjs, which
                                                                   #   produces the stored vectors. Distinct from GOOGLE_CLOUD_LOCATION below.
GCP_PRIVATE_KEY=                                                   # [secret] used when deployed instead of GOOGLE_APPLICATION_CREDENTIALS
VERTEX_AI_ACCESS_TOKEN=                                            # [secret] pre-minted Vertex token; overrides the WIF/ADC exchange when set
OPENAI_API_KEY=                                                    # [secret] optional — enables the GPT options in the assistant model picker
OPENAI_API_BASE_URL=                                               # [config] optional OpenAI-compatible endpoint override
ANTHROPIC_API_KEY=                                                 # [secret] optional — enables the Claude options in the assistant model picker

# ── Model + region selection for the Python services (swarm, verification harness)
GOOGLE_CLOUD_LOCATION=us-east5                                     # [config] Vertex region for the swarm and harness (generation models only)
VERTEX_GEMINI_MODEL=gemini-2.5-pro                                 # [config] swarm generation model — the main recurring cost lever
VERTEX_TIER2_MODEL=gemini-2.5-flash                                # [config] verification harness Tier 2/3 adjudication model
EXTRACT_MINUTES_MODEL=                                             # [config] historical; the swarm routes through the Vertex shim regardless

# ── App behaviour
INSTITUTION_LEGAL_NAME=St. John Fisher University                  # [config] injected into the catalog-correction prompt
CORRECTION_DAILY_LIMIT=150                                         # [config] per-user cap on correction-agent calls per day
SCRATCH_DIR=                                                       # [config] output dir for the one-shot backfill scripts (default ./artifacts/scratch)

# ── GCS assets (catalog PDFs / intake) — bucket already exists hub-side
#    Both names are read (GCP_BUCKET_NAME || GCS_BUCKET); keep them identical.
GCP_BUCKET_NAME=sjfu-assets                                        # [public]
GCS_BUCKET=sjfu-assets                                             # [public]

# ── GCS auth in DEPLOYED environments (Vercel): keyless Workload Identity Federation.
#    LOCAL dev needs none of these — it uses gcloud ADC (`gcloud auth login --update-adc`).
#    Without them the app cannot read GCS at all: it falls through to the ADC path, which
#    does not exist in a serverless runtime, and every source-page fetch fails.
#    The provider must match the Vercel project's OIDC *issuer mode*: `vercel-team` expects
#    the team issuer (https://oidc.vercel.com/<team>), which is what this project emits.
GCP_PROJECT_NUMBER=137015357492                                    # [public] GCP project NUMBER (not id) hosting the pool
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-pool                          # [public]
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel-team                 # [public]
GCP_SERVICE_ACCOUNT_EMAIL=sjf-catalog-app@cdi-factory-cloud.iam.gserviceaccount.com  # [public] impersonated SA; reads sjfu-assets only


# ── Tasks
CRON_SECRET=                                                       # [secret]
HUB_WEBHOOK_SECRET=                                                # [secret]
